// Wave — Prisma schema
// Targets Neon.tech PostgreSQL 16. See Wave_Technical_Document.md Section 7.
// Auth users live in Supabase (auth.users) — `profiles.id` references that UUID
// but Supabase's auth schema is not modeled here since Prisma never queries it.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProfileRole {
  student
  rider
  shop_owner
  admin
}

enum ProductStatus {
  active
  out_of_stock
  not_serving
}

enum DeliveryDay {
  sunday
  wednesday
  special
}

enum OrderType {
  // A runner buys the items from a shop and delivers them.
  buy_for_me
  // A runner collects a package the student already has at one checkpoint and
  // carries it to another. No shop, no item cost — the delivery fee is all of it.
  pickup
  // A runner buys from a shop that is NOT on Wave yet, because a student
  // suggested it. No catalogue means no price until the runner is at the till,
  // so the goods are charged as a second transaction after the rider records
  // what they actually paid. Shown to students as a kind of pickup.
  shop_pickup
}

enum SuggestionStatus {
  pending
  onboarded
  rejected
}

enum OrderStatus {
  pending
  payment_pending
  confirmed
  rider_assigned
  en_route
  at_checkpoint
  delivered
  cancelled
  refunded
}

enum RiderIdType {
  ghana_card
  student_id
  passport
}

/// Whether a rider is a student of the campus they serve, or someone hired from
/// outside it.
///
/// Deliberately its own column rather than inferred from `studentId` being
/// present. That field is optional and always has been, so a student who simply
/// did not type their ID would be read as external — which would then decide
/// which documents they must produce and, once a policy exists, what they are
/// paid. A question with consequences gets asked, not guessed.
enum RiderType {
  student
  external
}

enum VerificationStatus {
  pending
  approved
  rejected
}

enum EarningStatus {
  pending
  paid
}

model University {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  city      String
  country   String   @default("Ghana")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  profiles        Profile[]
  checkpoints     Checkpoint[]
  shops           Shop[]
  orders          Order[]
  shopSuggestions ShopSuggestion[]

  @@map("universities")
}

model Profile {
  id           String      @id @default(uuid())
  universityId String?     @map("university_id")
  fullName     String      @map("full_name")
  phone        String      @unique
  // Optional forever: auth is phone-based, so a student who never gives an
  // email must still be able to order. Used for the "the shop you suggested is
  // now on Wave" notification, which also goes out by push and SMS.
  email        String?
  studentId    String?     @map("student_id")
  role         ProfileRole
  avatarUrl    String?     @map("avatar_url")
  pushToken    String?     @map("push_token")
  // Two different questions, deliberately two columns. `isActive` is the ban
  // flag: `plugins/auth.ts` rejects every authenticated request when it is
  // false. `isAvailable` is the rider's own online/offline toggle. They were
  // the same column, so a rider tapping "Offline" locked themselves out of the
  // app and could not tap it back on — only an admin could. Nothing but a
  // rider ever reads `isAvailable`.
  isActive     Boolean     @default(true) @map("is_active")
  isAvailable  Boolean     @default(true) @map("is_available")
  isVerified   Boolean     @default(false) @map("is_verified")
  /// Riders only; null for every other role. Set during onboarding and not
  /// self-editable afterwards — `updateProfileSchema` is `.strict()` and omits
  /// it, because moving yourself from external to student would change which
  /// ID you are allowed to verify with.
  riderType    RiderType?  @map("rider_type")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  university University? @relation(fields: [universityId], references: [id])

  shops                 Shop[]
  studentOrders         Order[]               @relation("StudentOrders")
  riderOrders           Order[]               @relation("RiderOrders")
  orderStatusChanges    OrderStatusHistory[]
  riderVerification     RiderVerification[]   @relation("RiderVerifications")
  reviewedVerifications RiderVerification[]   @relation("ReviewedVerifications")
  studentDeliveryStats  StudentDeliveryStats?
  riderEarnings         RiderEarning[]
  shopSuggestions       ShopSuggestion[]

  @@map("profiles")
}

model Checkpoint {
  id                    String   @id @default(uuid())
  universityId          String   @map("university_id")
  name                  String
  description           String?
  latitude              Decimal? @db.Decimal(9, 6)
  longitude             Decimal? @db.Decimal(9, 6)
  isActive              Boolean  @default(true) @map("is_active")
  /// Whether a rider from outside the university may deliver here.
  ///
  /// Defaults to false — deny. An access rule that defaults to "allowed" is
  /// only a rule once someone remembers to turn it on, and the cost of the
  /// safe default is an empty feed, which the rider app explains. Student
  /// riders ignore this column entirely.
  externalRidersAllowed Boolean  @default(false) @map("external_riders_allowed")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  university   University @relation(fields: [universityId], references: [id])
  // Two relations because a pickup order references a checkpoint twice.
  orders       Order[]    @relation("OrderDropoff")
  pickupOrders Order[]    @relation("OrderPickup")

  @@map("checkpoints")
}

model Shop {
  id           String    @id @default(uuid())
  ownerId      String    @map("owner_id")
  universityId String    @map("university_id")
  name         String
  description  String?
  category     String
  logoUrl      String?   @map("logo_url")
  phone        String?
  locationText String?   @map("location_text")
  openingTime  DateTime? @map("opening_time") @db.Time
  closingTime  DateTime? @map("closing_time") @db.Time
  isActive     Boolean   @default(true) @map("is_active")
  isVerified   Boolean   @default(false) @map("is_verified")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  owner               Profile          @relation(fields: [ownerId], references: [id])
  university          University       @relation(fields: [universityId], references: [id])
  products            Product[]
  orders              Order[]
  resolvedSuggestions ShopSuggestion[] @relation("ResolvedSuggestions")

  @@map("shops")
}

model Product {
  id          String        @id @default(uuid())
  shopId      String        @map("shop_id")
  name        String
  description String?
  price       Decimal       @db.Decimal(10, 2)
  imageUrl    String?       @map("image_url")
  category    String?
  status      ProductStatus @default(active)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  shop       Shop        @relation(fields: [shopId], references: [id])
  orders     Order[]
  orderItems OrderItem[]

  @@map("products")
}

// One line of a student's basket.
//
// `name` and `unitPrice` are SNAPSHOTS, not lookups. A shop editing its price
// or deleting a product must never rewrite what someone already ordered and
// paid for, so the row carries its own copy and `productId` is nullable — both
// because a manual list has no product, and because the product may be gone by
// the time the order is read back.
model OrderItem {
  id              String   @id @default(uuid())
  orderId         String   @map("order_id")
  productId       String?  @map("product_id")
  name            String
  /// The catalogue price at the moment of ordering. Null on a manual list,
  /// where nobody knows the price until the runner reaches the till.
  unitPrice       Decimal? @map("unit_price") @db.Decimal(10, 2)
  quantity        Int      @default(1)
  /// What the rider actually paid. Only ever set on a `shop_pickup`, and only
  /// once they are standing in the shop.
  actualUnitPrice Decimal? @map("actual_unit_price") @db.Decimal(10, 2)
  createdAt       DateTime @default(now()) @map("created_at")

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

// A student asking for a shop Wave doesn't carry yet.
//
// Two jobs at once: it is the origin of a real `shop_pickup` order, and it is
// the demand signal admin ranks to decide which shop to onboard next.
//
// `normalizedName` is what makes the ranking work — "Melcom", "melcom " and
// "MELCOM Berekuso" must count as one place. The API normalizes on write and
// admin groups on this column, never on `name`.
model ShopSuggestion {
  id             String           @id @default(uuid())
  studentId      String           @map("student_id")
  universityId   String           @map("university_id")
  name           String
  normalizedName String           @map("normalized_name")
  locationText   String?          @map("location_text")
  category       String?
  status         SuggestionStatus @default(pending)
  /// Set when admin onboards the place and links it to the real shop row.
  resolvedShopId String?          @map("resolved_shop_id")
  /// When the suggester was told the shop is live. Guards against telling them twice.
  notifiedAt     DateTime?        @map("notified_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  student      Profile    @relation(fields: [studentId], references: [id])
  university   University @relation(fields: [universityId], references: [id])
  resolvedShop Shop?      @relation("ResolvedSuggestions", fields: [resolvedShopId], references: [id])
  orders       Order[]

  @@index([universityId, normalizedName])
  @@index([status])
  @@map("shop_suggestions")
}

model Order {
  id                 String  @id @default(uuid())
  studentId          String  @map("student_id")
  riderId            String? @map("rider_id")
  // Null for a package pickup: there is no shop involved, the student already
  // has the thing and just needs it carried.
  shopId             String? @map("shop_id")
  // Where a package is collected FROM. Null for a Buy For Me order, whose
  // origin is the shop.
  originCheckpointId String? @map("origin_checkpoint_id")
  // The suggested, not-yet-onboarded shop this run buys from. Set only on a
  // `shop_pickup`, where it stands in for `shopId`.
  suggestionId       String? @map("suggestion_id")
  // Where the order is handed to the student. Always set, for both kinds.
  checkpointId       String  @map("checkpoint_id")
  universityId       String  @map("university_id")

  orderType OrderType @default(buy_for_me) @map("order_type")

  itemDescription  String   @map("item_description")
  productId        String?  @map("product_id")
  itemPrice        Decimal? @map("item_price") @db.Decimal(10, 2)
  deliveryFee      Decimal  @map("delivery_fee") @db.Decimal(10, 2)
  discountApplied  Decimal  @default(0) @map("discount_applied") @db.Decimal(5, 2)
  surchargeApplied Decimal  @default(0) @map("surcharge_applied") @db.Decimal(5, 2)
  totalAmount      Decimal  @map("total_amount") @db.Decimal(10, 2)

  deliveryDay    DeliveryDay @map("delivery_day")
  scheduledDate  DateTime    @map("scheduled_date") @db.Date
  isSpecialOrder Boolean     @default(false) @map("is_special_order")

  status OrderStatus @default(pending)

  // When the shop confirmed they will fulfil this order. Advisory: it does not
  // gate anything, it records an acknowledgement the dashboard and riders can see.
  shopAcceptedAt DateTime? @map("shop_accepted_at")

  paystackRef String?   @unique @map("paystack_ref")
  paidAt      DateTime? @map("paid_at")

  // A `shop_pickup` is paid in two parts: the delivery fee at order time
  // (`paystackRef`), and the goods once the rider reports the till total.
  // Two refs because they are two Paystack transactions, and each needs its
  // own idempotency key for the webhook to be safe to replay.
  goodsPaystackRef String?   @unique @map("goods_paystack_ref")
  goodsPaidAt      DateTime? @map("goods_paid_at")

  // bcrypt for rider verify. Ciphertext (AES-GCM) so the owning student can
  // read the code in the app — never selected on general order queries.
  deliveryPinHash       String?   @map("delivery_pin_hash")
  deliveryPinCiphertext String?   @map("delivery_pin_ciphertext")
  // Failed PIN entries since the current PIN was issued. The rider assigned to
  // an order could otherwise grind the 6-digit space against it and close a
  // delivery they never handed over — nothing capped the guesses. Reset to 0
  // every time a PIN is issued or re-issued, and on a correct entry.
  deliveryPinAttempts   Int       @default(0) @map("delivery_pin_attempts")
  deliveredAt           DateTime? @map("delivered_at")

  // Cross-instance locks. Both used to be in-process (a Set and a Map in the
  // route modules), which held only while the API ran as a single instance —
  // two Render instances would each keep their own and enforce nothing.
  //
  // `refundStartedAt` is claimed with a conditional UPDATE before Paystack is
  // called, so exactly one caller can be refunding an order at a time. It is
  // cleared on failure so a retry is possible.
  refundStartedAt DateTime? @map("refund_started_at")
  // Last delivery-PIN resend, for the per-order cooldown. Each send costs money.
  lastPinResendAt DateTime? @map("last_pin_resend_at")

  notes              String?
  cancellationReason String? @map("cancellation_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  student          Profile         @relation("StudentOrders", fields: [studentId], references: [id])
  rider            Profile?        @relation("RiderOrders", fields: [riderId], references: [id])
  shop             Shop?           @relation(fields: [shopId], references: [id])
  checkpoint       Checkpoint      @relation("OrderDropoff", fields: [checkpointId], references: [id])
  originCheckpoint Checkpoint?     @relation("OrderPickup", fields: [originCheckpointId], references: [id])
  university       University      @relation(fields: [universityId], references: [id])
  product          Product?        @relation(fields: [productId], references: [id])
  suggestion       ShopSuggestion? @relation(fields: [suggestionId], references: [id])

  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  earning       RiderEarning?

  @@map("orders")
}

model OrderStatusHistory {
  id        String   @id @default(uuid())
  orderId   String   @map("order_id")
  status    String
  changedBy String?  @map("changed_by")
  note      String?
  createdAt DateTime @default(now()) @map("created_at")

  order   Order    @relation(fields: [orderId], references: [id])
  changer Profile? @relation(fields: [changedBy], references: [id])

  @@map("order_status_history")
}

model RiderVerification {
  id                 String       @id @default(uuid())
  riderId            String       @map("rider_id")
  idType             RiderIdType  @map("id_type")
  idNumber           String       @map("id_number")
  // Storage paths inside the private "verifications" bucket, never URLs. A
  // signed URL expires, so persisting one meant admin review broke a week
  // after submission; the API signs these fresh on every read instead.
  idImagePath        String       @map("id_image_path")
  selfiePath         String       @map("selfie_path")
  /// Everything below is required of an EXTERNAL rider and null for a student.
  ///
  /// A student rider is already tied to the institution — the campus knows who
  /// they are and where to find them. Someone hired from outside has no such
  /// tie, so the evidence has to stand on its own. Nullable columns rather than
  /// a separate table because a verification either carries them or does not,
  /// and the review screen reads one row.
  guarantorName      String?      @map("guarantor_name")
  guarantorPhone     String?      @map("guarantor_phone")
  secondIdType       RiderIdType? @map("second_id_type")
  secondIdNumber     String?      @map("second_id_number")
  secondIdImagePath  String?      @map("second_id_image_path")
  proofOfAddressPath String?      @map("proof_of_address_path")
  referenceName      String?      @map("reference_name")
  referenceContact   String?      @map("reference_contact")

  status          VerificationStatus @default(pending)
  reviewedBy      String?            @map("reviewed_by")
  rejectionReason String?            @map("rejection_reason")
  reviewedAt      DateTime?          @map("reviewed_at")
  createdAt       DateTime           @default(now()) @map("created_at")

  rider    Profile  @relation("RiderVerifications", fields: [riderId], references: [id])
  reviewer Profile? @relation("ReviewedVerifications", fields: [reviewedBy], references: [id])

  @@map("rider_verifications")
}

model StudentDeliveryStats {
  studentId        String   @id @map("student_id")
  totalDeliveries  Int      @default(0) @map("total_deliveries")
  discountEligible Boolean  @default(false) @map("discount_eligible")
  updatedAt        DateTime @updatedAt @map("updated_at")

  student Profile @relation(fields: [studentId], references: [id])

  @@map("student_delivery_stats")
}

model RiderEarning {
  id        String        @id @default(uuid())
  riderId   String        @map("rider_id")
  orderId   String        @unique @map("order_id")
  amount    Decimal       @db.Decimal(10, 2)
  /// The percentage actually applied when this row was written.
  ///
  /// Student and external riders are paid at different configurable rates, and
  /// both are editable in admin with no deploy. Without this column, changing a
  /// rate would silently rewrite the apparent basis of every past delivery, and
  /// a rider disputing an old payment could not be answered.
  ratePct   Decimal?      @map("rate_pct") @db.Decimal(5, 2)
  status    EarningStatus @default(pending)
  paidAt    DateTime?     @map("paid_at")
  createdAt DateTime      @default(now()) @map("created_at")

  rider Profile @relation(fields: [riderId], references: [id])
  order Order   @relation(fields: [orderId], references: [id])

  @@map("rider_earnings")
}

model PlatformConfig {
  key         String   @id
  value       String
  description String?
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("platform_config")
}
