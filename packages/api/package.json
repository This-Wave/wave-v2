{
  "name": "@wave/api",
  "version": "0.1.0",
  "private": true,
  "description": "Wave Fastify REST API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "npm run build --workspace=@wave/shared && npm run build --workspace=@wave/db && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit",
    "test:unit": "vitest run src --exclude '**/__tests__/*.integration.test.ts'",
    "test:integration": "vitest run src/**/*.integration.test.ts",
    "start:local": "node --env-file=.env dist/index.js"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/sensible": "^5.6.0",
    "@supabase/supabase-js": "^2.45.4",
    "@wave/db": "*",
    "@wave/shared": "*",
    "axios": "^1.7.7",
    "bcrypt": "^5.1.1",
    "fastify": "^4.28.1",
    "fastify-plugin": "^4.5.1",
    "fastify-raw-body": "^4.3.0",
    "standardwebhooks": "^1.0.0",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^20.14.15",
    "@types/ws": "^8.5.13",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "eslint": "^8.57.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
