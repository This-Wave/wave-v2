DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/wave?sslmode=require

SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

PAYSTACK_SECRET_KEY=sk_test_...
# NOTE: there is deliberately no PAYSTACK_WEBHOOK_SECRET. Paystack signs webhooks
# with your SECRET KEY, so `paystack.ts` computes the HMAC from
# PAYSTACK_SECRET_KEY above. A separate webhook secret does not exist in the
# Paystack dashboard and setting one here does nothing.

# AES key for the encrypted copy of each delivery PIN (orders/pinCrypto.ts).
# Despite the name it does NOT sign JWTs — Supabase Auth issues those.
# Rotating it makes undelivered PINs undecryptable; drain in-flight orders first.
JWT_SECRET=
APP_URL=http://localhost:4000
# Required in production (Render). Comma-separated admin + student web origins.
# CORS_ORIGINS=https://wave-admin.onrender.com,https://wave-liart-pi.vercel.app
PORT=4000
NODE_ENV=development

# ── SMS: OTP and delivery PINs (mNotify) ───────────────────────────────────
# Without MNOTIFY_API_KEY the API still starts and orders still work, but NO
# OTP and NO delivery PIN is ever sent — `issueDeliveryPin` logs and returns
# `smsSent: false`. Easy to miss in dev; fatal in production.
MNOTIFY_API_KEY=
# `Wave` is DECLINED by mNotify; `TACCBooking` is the approved sender.
MNOTIFY_SENDER_ID=TACCBooking
# Shared secret for Supabase Auth's "Send SMS Hook" (Standard Webhooks).
# Set the same value in Supabase dashboard → Auth → Hooks.
SMS_HOOK_SECRET=

# ── Shop-live alert emails (Resend) ────────────────────────────────────────
# Optional, and `sendEmailQuietly` no-ops rather than throwing when unset — so
# leaving this blank means shop-live emails silently never send, with no error.
RESEND_API_KEY=
RESEND_FROM=Wave <notifications@wave.app>

# ── Optional error monitoring ──────────────────────────────────────────────
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# Abandoned-checkout sweep (plugins/sweeper.ts). Every ~10 minutes, orders that
# have sat unpaid for 45 minutes are checked against Paystack: paid-but-never-
# confirmed ones are recovered, genuinely unpaid ones are cancelled. Defaults to
# true. Set false only if something external drives
# POST /v1/admin/payments/sweep-abandoned instead.
# SWEEP_ENABLED=true
