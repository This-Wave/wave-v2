# Caddy fronts every site on the droplet and gets HTTPS certificates for each
# hostname automatically. Hostnames come from /opt/wave/.env.
#
# To host another app: add its container to docker-compose.yml (no `ports:`),
# point a DNS record at the droplet, add a block below, and run ./deploy.sh.

{
	email {$ACME_EMAIL}
}

# LEGACY_API_HOST keeps the old sslip.io name answering while Paystack, Moolre
# and the Supabase SMS hook still point at it. Empty = only the new name.
{$API_HOST} {$LEGACY_API_HOST} {
	encode zstd gzip
	reverse_proxy api:4000
}

{$ADMIN_HOST} {
	encode zstd gzip
	reverse_proxy admin:3000
}

{$WEB_HOST} {
	root * /srv/web
	encode zstd gzip

	# Same headers apps/mobile/vercel.json set. A cached service worker or
	# manifest would keep students on an old build of the app.
	header /sw.js Cache-Control "public, max-age=0, must-revalidate"
	header /sw.js Service-Worker-Allowed "/"
	header /manifest.webmanifest Cache-Control "public, max-age=0, must-revalidate"
	header /manifest.webmanifest Content-Type "application/manifest+json"
	header /_expo/static/* Cache-Control "public, max-age=31536000, immutable"

	# Client-side routing: unknown paths load the app shell.
	try_files {path} /index.html
	file_server
}

# Marketing site: plain static files from apps/site, baked into this image.
{$SITE_HOST} {
	root * /srv/site
	encode zstd gzip
	header /assets/* Cache-Control "public, max-age=86400"
	try_files {path} {path}.html {path}/index.html
	file_server
}

www.{$SITE_HOST} {
	redir https://{$SITE_HOST}{uri} permanent
}

# Old hostnames (e.g. app.<ip>.sslip.io) send people to the new ones. Unset = a
# plain-HTTP placeholder that never resolves, so Caddy requests no certificate.
{$LEGACY_WEB_HOST:http://legacy-web.invalid} {
	redir https://{$WEB_HOST}{uri} permanent
}

{$LEGACY_ADMIN_HOST:http://legacy-admin.invalid} {
	redir https://{$ADMIN_HOST}{uri} permanent
}

