# Copy to /opt/wave/.env on the droplet and fill in. Never commit the filled copy.
# Runbook: docs/digitalocean-hosting.md

# ── Hostnames (Caddy gets an HTTPS certificate for each) ──
# Each needs a DNS A record pointing at the droplet before the first deploy.
API_HOST=api.usewavenow.com
ADMIN_HOST=admin.usewavenow.com
WEB_HOST=app.usewavenow.com
# Marketing site (apps/site). www.$SITE_HOST redirects to it.
SITE_HOST=usewavenow.com
# Optional: old hostnames to keep during a domain move. The API one keeps
# proxying (webhooks, Paystack callbacks); app and admin redirect to the new host.
# LEGACY_API_HOST=api.138-197-7-241.sslip.io
# LEGACY_ADMIN_HOST=admin.138-197-7-241.sslip.io
# LEGACY_WEB_HOST=app.138-197-7-241.sslip.io
ACME_EMAIL=you@example.com

# ── API ──
# Must be https://$API_HOST. Paystack sends payers to ${APP_URL}/v1/payments/callback.
APP_URL=https://api.usewavenow.com
# The admin and web origins, comma-separated.
CORS_ORIGINS=https://admin.usewavenow.com,https://app.usewavenow.com

# Neon production branch: pooled for the app, direct for migrations.
DATABASE_URL=
DIRECT_URL=

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SMS_HOOK_SECRET=

# Copy Render's value exactly: it decrypts delivery PINs already stored.
JWT_SECRET=

PAYSTACK_SECRET_KEY=

# ── Mobile Money (Moolre) ─────────────────────────────────────────────────────
# MoMo goes through Moolre; cards stay on Paystack above. Until USER, PUBLIC_KEY
# and ACCOUNT_NUMBER are set, MoMo checkout answers "not set up yet".
# Sandbox: MOOLRE_BASE_URL=https://sandbox.moolre.com with the sandbox keys.
# Webhook URL to give Moolre: ${APP_URL}/v1/payments/webhook/moolre
MOOLRE_BASE_URL=https://api.moolre.com
MOOLRE_API_USER=
MOOLRE_PUBLIC_KEY=
# Private key: refunds only (Moolre pays refunds out as a transfer).
MOOLRE_PRIVATE_KEY=
MOOLRE_ACCOUNT_NUMBER=
MOOLRE_WEBHOOK_SECRET=
# moolre | paystack — which provider takes Mobile Money.
MOMO_PROVIDER=moolre
# paystack | off — card payments.
CARD_PAYMENTS=paystack

MNOTIFY_API_KEY=
# `Wave` is declined by mNotify.
MNOTIFY_SENDER_ID=TACCBooking

# Optional. Live Telegram reports of what test accounts do (sign-in, sign-out,
# every screen and action). Leave both commented out to turn it off.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Optional. Web Push for the web app added to a home screen (Android, iOS 16.4+).
# Generate once: `npx web-push generate-vapid-keys`. Changing the pair cuts off
# every existing subscriber until they turn notifications on again.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=https://app.usewavenow.com

# Optional. Leave commented out rather than empty: an empty SENTRY_DSN fails the
# URL check and the API will not start.
# SENTRY_DSN=
# RESEND_API_KEY=
RESEND_FROM=Wave <notifications@wave.app>
SWEEP_ENABLED=true
