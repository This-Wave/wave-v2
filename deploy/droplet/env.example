# Copy to /opt/wave/.env on the droplet and fill in. Never commit the filled copy.
# Runbook: docs/digitalocean-hosting.md

# ── Hostnames (Caddy gets an HTTPS certificate for each) ──
# Each needs a DNS A record pointing at the droplet before the first deploy.
API_HOST=api.example.com
ADMIN_HOST=admin.example.com
WEB_HOST=app.example.com
ACME_EMAIL=you@example.com

# ── API ──
# Must be https://$API_HOST. Paystack sends payers to ${APP_URL}/v1/payments/callback.
APP_URL=https://api.example.com
# The admin and web origins, comma-separated.
CORS_ORIGINS=https://admin.example.com,https://app.example.com

# Neon production branch: pooled for the app, direct for migrations.
DATABASE_URL=
DIRECT_URL=

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SMS_HOOK_SECRET=

# Copy Render's value exactly: it decrypts delivery PINs already stored.
JWT_SECRET=

PAYSTACK_SECRET_KEY=

MNOTIFY_API_KEY=
# `Wave` is declined by mNotify.
MNOTIFY_SENDER_ID=TACCBooking

# Optional. Leave commented out rather than empty: an empty SENTRY_DSN fails the
# URL check and the API will not start.
# SENTRY_DSN=
# RESEND_API_KEY=
RESEND_FROM=Wave <notifications@wave.app>
SWEEP_ENABLED=true
