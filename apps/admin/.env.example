# Must match PORT in packages/api/.env. Note that 4000 is also the Firebase
# Emulator Suite's default UI port — if you run that, move both to e.g. 4010,
# or the dashboard will silently talk to the emulator instead of the API.
NEXT_PUBLIC_API_URL=http://localhost:4000/v1
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional — error monitoring (inlined at build time)
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
