EXPO_PUBLIC_API_URL=http://localhost:4000/v1
EXPO_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_...
# Optional — error monitoring
# EXPO_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
# Pilot week support contact (shown on student Profile when set)
# EXPO_PUBLIC_SUPPORT_EMAIL=support@wave.app
# EXPO_PUBLIC_SUPPORT_WHATSAPP=233XXXXXXXXX
# Legal pages. Served as static files by the Expo web deploy on Vercel — the
# build generates them from packages/shared/src/legal/content.ts, so these URLs
# are live wherever the student web app is deployed. Deliberately NOT the admin
# dashboard: that runs on Render's free tier and cold-started at 53s when
# measured, which is too slow for a link tapped at signup or fetched by an app
# store reviewer. The admin mirrors the same documents at /legal/* as a backup.
EXPO_PUBLIC_TERMS_URL=https://wave-liart-pi.vercel.app/legal/terms.html
EXPO_PUBLIC_PRIVACY_URL=https://wave-liart-pi.vercel.app/legal/privacy.html
