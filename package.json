{
  "name": "wave",
  "version": "0.1.0",
  "private": true,
  "description": "Wave — campus delivery platform for Ghanaian universities (pilot: Ashesi University)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev:api": "npm run dev --workspace=@wave/api",
    "dev:admin": "npm run dev --workspace=@wave/admin",
    "dev:mobile": "npm run start --workspace=@wave/mobile",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "type-check": "npm run type-check --workspaces --if-present",
    "test:unit": "npm run test:unit --workspaces --if-present",
    "test:integration": "npm run test:integration --workspaces --if-present",
    "db:generate": "npm run generate --workspace=@wave/db",
    "db:migrate": "npm run migrate:dev --workspace=@wave/db",
    "db:studio": "npm run studio --workspace=@wave/db",
    "db:seed": "npm run seed --workspace=@wave/db",
    "db:seed:auth": "npm run seed:auth --workspace=@wave/db"
  },
  "devDependencies": {
    "typescript": "^5.5.4"
  },
  "overrides": {
    "tailwindcss": "3.3.2",
    "postcss": "8.4.31"
  }
}
