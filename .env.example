# Wave — Root environment reference.
# This file documents every env var used across the monorepo.
# Actual values live in per-package .env files (never committed):
#   packages/db/.env, packages/api/.env, apps/admin/.env.local, apps/mobile/.env

# ── Database (Neon.tech — NEVER Supabase DB, it pauses) ─────────────────────
DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/wave?sslmode=require
# DATABASE_URL=postgresql://...@db.digitalocean.com/wave  # upgrade path, not active

# ── Supabase (Auth + Storage + Realtime only) ────────────────────────────────
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# ── Payments (Paystack) ───────────────────────────────────────────────────────
# Paystack signs webhooks with an HMAC-SHA512 of the secret key below —
# there is no separate webhook signing secret.
# API (Render): PAYSTACK_SECRET_KEY must be sk_test_… or sk_live_… — NOT pk_test_…
# Mobile (Vercel): EXPO_PUBLIC_PAYSTACK_PUBLIC_KEY is the matching pk_… public key.
PAYSTACK_SECRET_KEY=sk_test_...

# ── Real phone OTP (mNotify, via a Supabase "Send SMS Hook") ────────────────
# Supabase Auth still generates/verifies the OTP itself (signInWithOtp /
# verifyOtp on the client, unchanged) -- it only delegates the SMS *send*
# step to POST /v1/auth/sms-hook, which relays to mNotify. Configure this
# hook's URL + secret in the Supabase dashboard: Authentication → Hooks →
# Send SMS Hook. SMS_HOOK_SECRET is the "v1,whsec_..." value Supabase gives
# you there, not something you invent yourself.
SMS_HOOK_SECRET=v1,whsec_...
MNOTIFY_API_KEY=
MNOTIFY_SENDER_ID=Wave

# ── API ────────────────────────────────────────────────────────────────────
# AES key for the encrypted copy of each delivery PIN (orders/pinCrypto.ts).
# Despite the name it does NOT sign JWTs — Supabase Auth issues those.
# Rotating it makes undelivered PINs undecryptable; drain in-flight orders first.
JWT_SECRET=
APP_URL=http://localhost:4000
# Production (Render API): comma-separated admin + student web origins, e.g.
# CORS_ORIGINS=https://wave-admin.onrender.com,https://wave-liart-pi.vercel.app
CORS_ORIGINS=
PORT=4000
NODE_ENV=development

# ── Mobile (Expo, must be prefixed EXPO_PUBLIC_) ─────────────────────────────
EXPO_PUBLIC_API_URL=http://localhost:4000/v1
EXPO_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_...

# ── Admin (Next.js) ───────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000/v1
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Monitoring ────────────────────────────────────────────────────────────────
SENTRY_DSN=
